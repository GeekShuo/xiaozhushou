page { background: #0f1419; color: #e6edf3; font-family: -apple-system, "PingFang SC", sans-serif; }
.btn { background: #4ade80; color: #06210f; border-radius: 12rpx; padding: 22rpx; font-weight: 600; text-align: center; margin: 16rpx 0; }
.card { background: #172033; border: 1px solid #233044; border-radius: 16rpx; padding: 24rpx; margin: 16rpx; }
.muted { color: #8b98a9; font-size: 26rpx; }
.title { font-size: 32rpx; font-weight: 700; }
.row { display: flex; justify-content: space-between; align-items: center; }
